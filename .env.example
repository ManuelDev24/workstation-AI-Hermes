# Copia a .env (ignorado por git) SOLO si un proyecto lo necesita. Nunca subas valores reales.
# Los bots deterministas de aiws NO requieren ninguna de estas variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# Base de datos externa (Bot 2, deshabilitado por defecto; ver configs/external_db.example.yaml)
EXTERNAL_DB_URL=
# Canales de alerta externos del Bot 3 (deshabilitados; no hay código que los use todavía)
ALERT_WEBHOOK_URL=
